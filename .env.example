# -----------------------------------------------------------------------------
#  Copy this file to ".env" (same folder) and fill in real values.
#  ".env" is git-ignored: it must NEVER be committed.
#  On CI, set the same names as secret environment variables instead.
#  Keep THIS file with empty values - it is committed to Git.
# -----------------------------------------------------------------------------

# eZAZI test account used by tests in the "requires-backend" group
EZAZI_USERNAME=
EZAZI_PASSWORD=
